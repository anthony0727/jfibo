jfibo:JapaneseListedShare a owl:Class ;
    dcterms:source <https://www.fsa.go.jp/search/20251111.html> ;
    rdfs:isDefinedBy jfibo: ;
    rdfs:subClassOf fibo-sec-eq-eq:ListedShare ;
    skos:definition "A listed share of an issuer whose disclosure is represented in Japanese securities reporting data."@en,
        "日本の金融商品取引所に上場している株式を表すJ-FIBOクラス。FIBOのListedShareをJP市場文脈で特化したもの。"@ja ;
    skos:prefLabel "Japanese listed share"@en,
        "日本上場株式"@ja ;
    prov:wasAttributedTo <https://w3id.org/jfibo/contributor/jfibo-wg-bootstrap> ;
    prov:wasGeneratedBy <https://w3id.org/jfibo/session/2026-05-25-v0.1-bootstrap> ;
    jfibo:level "align" ;
    jfibo:status "proposed" .

jfibo:JapaneseYen a owl:NamedIndividual ;
    dcterms:source <https://www.iso.org/iso-4217-currency-codes.html> ;
    rdfs:isDefinedBy <https://w3id.org/jfibo/ontology/JP/external-alignment/> ;
    skos:notation "JPY" ;
    skos:prefLabel "Japanese yen"@en,
